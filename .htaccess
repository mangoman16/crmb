# The web root may point at this folder or at public/. Both work.
#
# Shared hosting usually fixes the web root at the account's public_html and
# offers no way to move it, so a request that lands here is rewritten into
# public/ instead of being refused. Nothing outside public/ becomes reachable by
# doing that: /config/config.php is rewritten to /public/config/config.php,
# which does not exist.
#
# The folders outside public/ each deny themselves as well, so that protection
# does not depend on mod_rewrite being enabled at all.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Already inside public/ - leave it alone, or this would loop.
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite these are the only files at this level a request could
# otherwise read.
<FilesMatch "\.(md|json|lock|sql|sh|ya?ml|bundle|example|log|txt|dist)$">
    Require all denied
</FilesMatch>
# The three files without an extension to match: the release number, the
# checksums of every PHP and SQL file, and the commit the package was built from.
<FilesMatch "^(VERSION|MANIFEST|BUILD\.txt)$">
    Require all denied
</FilesMatch>

# A git checkout in public_html carries .git/, and with it every file's whole
# history, beside other dot-files nobody should be served (.claude/, a stray
# .env). The rewrite above already sends such a request into public/, where
# nothing matches; this answers 404 even where mod_rewrite is off. .well-known/
# stays reachable because the hosting panel renews the certificate through it.
# The guard is deliberate: a directive the server does not know is a 500 on
# every page, and a portal that is down is worse than the gap this closes.
<IfModule mod_alias.c>
    RedirectMatch 404 /\.(?!well-known/)
</IfModule>
